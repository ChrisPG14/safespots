# Copia este archivo como .env y ajusta los valores.
# .env está en .gitignore: nunca subas credenciales al repositorio.

# ---------------------------------------------------------------------------
# Base de datos
# ---------------------------------------------------------------------------
# Local con docker compose (puerto 5433 para no chocar con un Postgres del
# sistema en el 5432):
DATABASE_URL=postgresql://geo:geo@localhost:5433/georisk

# En Neon la cadena viene del panel del proyecto y ya incluye la contraseña.
# Recuerda habilitar PostGIS una sola vez:  CREATE EXTENSION postgis;
# DATABASE_URL=postgresql://usuario:contrasena@ep-xxx.aws.neon.tech/georisk?sslmode=require

# ---------------------------------------------------------------------------
# Asistente de colonias (Gemini)
# ---------------------------------------------------------------------------
# Clave gratuita de Google AI Studio: https://aistudio.google.com/apikey
#
# Se lee SOLO en el servidor. Nunca la pongas con el prefijo NEXT_PUBLIC_:
# eso la publicaría en el navegador de cualquier visitante.
#
# No hace falta reiniciar el servidor tras cambiarla; la configuración se relee
# en cada petición. Sin clave, el mapa funciona igual y el asistente responde
# que todavía no está habilitado.
GEMINI_API_KEY=

# Cualquier modelo de tu cuenta que admita salida estructurada.
GEMINI_MODEL=gemini-3.6-flash

# ---------------------------------------------------------------------------
# ETL
# ---------------------------------------------------------------------------
# Dónde guardar las descargas. Por omisión ./data
# GEORISK_DATA_DIR=/ruta/absoluta/a/data
