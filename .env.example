# Copia este archivo como .env y ajusta los valores.
# .env está en .gitignore: nunca subas credenciales al repositorio.

# ---------------------------------------------------------------------------
# Base de datos
# ---------------------------------------------------------------------------
# Local con docker compose (puerto 5433 para no chocar con un Postgres del
# sistema en el 5432):
DATABASE_URL=postgresql://geo:geo@localhost:5433/georisk

# En Neon la cadena viene del panel del proyecto y ya incluye la contraseña.
# Recuerda habilitar PostGIS una sola vez:  CREATE EXTENSION postgis;
# DATABASE_URL=postgresql://usuario:contrasena@ep-xxx.us-east-2.aws.neon.tech/georisk?sslmode=require

# ---------------------------------------------------------------------------
# ETL
# ---------------------------------------------------------------------------
# Dónde guardar las descargas. Por omisión ./data
# GEORISK_DATA_DIR=/ruta/absoluta/a/data
